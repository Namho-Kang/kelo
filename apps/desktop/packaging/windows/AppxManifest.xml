<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package of Kelo for Windows (MSIX). make_msix.ps1 fills the ${...} values and packs the app folder
  (./gradlew createDistributable) with this manifest and the tiles in ../icons/msix.

  Fill these from Partner Center (Apps and games → Kelo → Product management → Product identity), as repository variables
  of the GitHub workflow or as parameters of make_msix.ps1:
    ${IDENTITY_NAME}            Package/Identity/Name                e.g. 12345YourName.Kelo
    ${PUBLISHER}                Package/Identity/Publisher           e.g. CN=1A2B3C4D-5E6F-7A8B-9C0D-112233445566
    ${PUBLISHER_DISPLAY_NAME}   Package/Properties/PublisherDisplayName
    ${DISPLAY_NAME}             Package/Properties/DisplayName and the tile's name: a name reserved for the product (e.g. Kelo AI)
  ${VERSION} is four numbers with the last one 0 (the Store's rule), e.g. 1.0.0.0.

  runFullTrust: Kelo is a regular desktop program (a Java runtime and Kelo.exe from jpackage) packaged as it is.
  windows.startupTask: "start at sign-in" for the Store version; off until the user turns it on in Settings → Apps → Startup.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop rescap">

  <Identity Name="${IDENTITY_NAME}" Publisher="${PUBLISHER}" Version="${VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>${DISPLAY_NAME}</DisplayName>
    <PublisherDisplayName>${PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Kelo, your own AI agent, on your Windows PC. Connects to your Kelo server.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- The Store asks for a listing (text and screenshots) per language named here; the app itself carries all its languages and
         follows Windows' language either way. Add a language here only together with its Store listing. -->
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
  </Resources>

  <Applications>
    <Application Id="Kelo" Executable="Kelo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="${DISPLAY_NAME}"
        Description="Kelo, your own AI agent"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#FFF3D6" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="Kelo.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="KeloStartup" Enabled="false" DisplayName="Kelo" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
