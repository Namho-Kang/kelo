<?xml version="1.0" encoding="utf-8"?>
<!-- 이 기기에서: what this phone can share with the user's own Kelo server (chat.kelo.app.device). Short words: one line in the list,
     at most two short lines in a sheet. -->
<resources>
    <string name="device_section">On this phone</string>
    <string name="device_row_sub">On this phone</string>
    <string name="device_row_connect">Connect</string>
    <string name="device_connected">Connected</string>
    <string name="device_needs_permission">Needs permission</string>

    <string name="device_calendar">Calendar</string>
    <string name="device_contacts">Contacts</string>
    <string name="device_messages">Messages</string>
    <string name="device_dialer">Phone dialer</string>
    <string name="device_notifications">Notifications</string>
    <string name="device_call_log">Call history</string>
    <string name="device_health">Health Connect</string>

    <!-- what Kelo can do (line 1) and what goes to the server (line 2) -->
    <string name="device_calendar_does">Reads your events to answer. If you allow it, adds events too, after you approve.</string>
    <string name="device_calendar_sends">Sends events from the past 7 days to the next 60 days to your server.</string>
    <string name="device_contacts_does">Finds numbers and emails by name. Read only.</string>
    <string name="device_contacts_sends">Sends names, numbers, emails, company and title, and birthdays to your server.</string>
    <string name="device_messages_does">Finds and reads texts you got and sent. Sends only after you approve.</string>
    <string name="device_messages_sends">Sends your recent texts to your server.</string>
    <string name="device_dialer_does">After you approve, opens the phone app with the number filled in. You tap call yourself.</string>
    <string name="device_dialer_sends">Nothing is sent.</string>
    <string name="device_notifications_does">Finds what you need in the notifications you got.</string>
    <string name="device_notifications_sends">Sends the app name, title, text and time to your server. Deleted after 7 days.</string>
    <string name="device_call_log_does">Finds recent calls. Read only.</string>
    <string name="device_call_log_sends">Sends the last 30 days\' numbers, names, call type, time and length to your server.</string>
    <string name="device_health_does">Answers from records like steps and sleep. Read only.</string>
    <string name="device_health_sends">Sends only a daily summary of the items you pick to your server, when you open the app.</string>

    <!-- the sheet -->
    <string name="device_switch">Let Kelo use this</string>
    <string name="device_auto">Keeps in sync on its own · %1$s</string>
    <string name="device_auto_never">Sends as soon as it\'s on, then keeps in sync</string>
    <string name="device_auto_foreground">Syncs each time you open the app · %1$s</string>
    <string name="device_send_now">Send now</string>
    <string name="device_sending">Sending…</string>
    <string name="device_send_failed">Couldn\'t send. I\'ll try again in a bit.</string>
    <string name="device_off_failed">Turned off. What\'s left on the server is deleted next time it connects.</string>
    <string name="device_denied">Permission is off. Allow it in Settings to turn this on.</string>
    <string name="device_open_settings">Open Settings</string>
    <string name="device_ready">On</string>
    <plurals name="device_count_contacts">
        <item quantity="one">%1$d contact</item>
        <item quantity="other">%1$d contacts</item>
