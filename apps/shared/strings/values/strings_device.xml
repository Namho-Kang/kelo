        <item quantity="other">%1$d calls</item>
    </plurals>
    <plurals name="device_count_days">
        <item quantity="one">%1$d day of summaries</item>
        <item quantity="other">%1$d days of summaries</item>
    </plurals>
    <plurals name="device_count_notes">
        <item quantity="one">%1$d notification</item>
        <item quantity="other">%1$d notifications</item>
    </plurals>
    <plurals name="device_count_events">
        <item quantity="one">%1$d event</item>
        <item quantity="other">%1$d events</item>
    </plurals>

