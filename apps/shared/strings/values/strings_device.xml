    <!-- notifications -->
    <string name="device_notif_service_label">Kelo notification reading</string>
    <string name="device_notif_disclosure_title">Share notifications with Kelo?</string>
    <string name="device_notif_disclosure">When this is on, the app name, title, text and time of notifications on this phone go to your Kelo server. Your agent uses them to find things and answer you. Ongoing notifications, Kelo\'s own and apps you exclude are never sent. The server deletes them after 7 days, and right away when you turn this off.\n\nOn the next screen, turn on notification access for Kelo.</string>
    <string name="device_agree">Agree and continue</string>
    <string name="device_decline">No thanks</string>
    <string name="device_notif_access_off">Notification access is off.</string>
    <string name="device_notif_exclude">Apps not to send</string>
    <string name="device_notif_exclude_empty">Apps that send you notifications show up here.</string>

    <!-- health -->
    <string name="device_health_types">What to share</string>
    <string name="device_health_steps">Steps</string>
    <string name="device_health_sleep">Sleep</string>
    <string name="device_health_heart">Heart rate</string>
    <string name="device_health_weight">Weight</string>
    <string name="device_health_exercise">Workouts</string>
    <string name="device_health_missing">Health Connect isn\'t on this phone.</string>
    <string name="device_health_install">Install Health Connect</string>
    <string name="device_health_denied">No permission for the items you picked. Please allow them again.</string>
    <string name="device_health_allow">Allow</string>
    <string name="device_health_rationale_title">How Kelo uses your health records</string>
    <string name="device_health_rationale">Kelo reads only a daily summary of the items you pick (steps, sleep, heart rate, weight, workouts) and sends it to your own Kelo server. It\'s used only when your agent answers your questions, never for ads or sales. Kelo only reads and never writes to Health Connect. Turning it off deletes the summaries on the server.</string>
    <string name="device_privacy_policy">Privacy policy</string>

    <!-- work the phone does after an approval -->
    <string name="device_dial_title">Call %1$s</string>
    <string name="device_dial_body">Tap to open the phone app. You place the call yourself.</string>
    <string name="device_sms_failed_title">Couldn\'t send the text</string>
</resources>
