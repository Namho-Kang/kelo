    <string name="device_calendar_does">Czyta twoje wydarzenia, żeby odpowiadać. Jeśli zezwolisz, dodaje też wydarzenia – po twojej zgodzie.</string>
    <string name="device_calendar_sends">Wysyła na twój serwer wydarzenia od 7 dni wstecz do 60 dni naprzód.</string>
    <string name="device_contacts_does">Znajduje numery i e-maile po nazwisku. Tylko odczyt.</string>
    <string name="device_contacts_sends">Wysyła na twój serwer imiona i nazwiska, numery, e-maile, firmę i stanowisko oraz urodziny.</string>
    <string name="device_messages_does">Znajduje i czyta odebrane i wysłane SMS-y. Wysyła tylko po twojej zgodzie.</string>
    <string name="device_messages_sends">Wysyła na twój serwer twoje ostatnie SMS-y.</string>
    <string name="device_dialer_does">Po twojej zgodzie otwiera aplikację Telefon z wpisanym numerem. Połączenie wybierasz sam.</string>
    <string name="device_dialer_sends">Nic nie jest wysyłane.</string>
    <string name="device_notifications_does">Znajduje to, czego potrzebujesz, w otrzymanych powiadomieniach.</string>
    <string name="device_notifications_sends">Wysyła na twój serwer nazwę aplikacji, tytuł, treść i godzinę. Usuwane po 7 dniach.</string>
